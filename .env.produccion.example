# Variables de SIGMA en producción. En la VPS se copia a /opt/apps/sigma/.env con chmod 600.
# NUNCA subir el .env real a Git.

APP_NAME=SIGMA
APP_ENV=production
APP_DEBUG=false
# Generar con: docker compose run --rm sigma_backend php artisan key:generate --show
APP_KEY=
APP_URL=https://sigma.proyectoscampus.top
FRONTEND_URL=https://sigma.proyectoscampus.top
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Base de datos propia de SIGMA (contenedor sigma_db, red privada).
DB_CONNECTION=pgsql
DB_HOST=sigma_db
DB_PORT=5432
DB_DATABASE=sigma
DB_USERNAME=sigma
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Administrador inicial (se crea una sola vez).
ADMIN_EMAIL=
ADMIN_PASSWORD=

SIGMA_MINUTOS_INACTIVIDAD=10
SIGMA_INTENTOS_MAXIMOS=5
SIGMA_MINUTOS_BLOQUEO=15

# Correo: "log" guarda los correos en el registro; configurar SMTP para enviarlos de verdad.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@proyectoscampus.top"
MAIL_FROM_NAME="SIGMA"
