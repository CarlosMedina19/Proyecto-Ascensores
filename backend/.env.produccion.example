# Variables de SIGMA en producción. En la VPS se copia a /opt/apps/sigma/backend/.env con chmod 600.
# NUNCA subir el .env real a Git.

APP_NAME=SIGMA
APP_ENV=production
APP_DEBUG=false
# Generar con: php artisan key:generate --show (en cualquier copia del backend)
APP_KEY=
APP_URL=https://sigma.proyectoscampus.top
FRONTEND_URL=https://sigma.proyectoscampus.top
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Base de datos propia de SIGMA (contenedor sigma_db, red privada).
DB_CONNECTION=pgsql
DB_HOST=sigma_db
DB_PORT=5432
DB_DATABASE=sigma
DB_USERNAME=sigma
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Administrador inicial (se crea una sola vez).
ADMIN_EMAIL=
ADMIN_PASSWORD=

SIGMA_MINUTOS_INACTIVIDAD=10
# Vencimiento absoluto de los tokens de sesión, en minutos (12 horas). 0 = sin vencimiento.
SANCTUM_EXPIRATION=720
SIGMA_INTENTOS_MAXIMOS=5
SIGMA_MINUTOS_BLOQUEO=15

# Correo: "log" guarda los correos en el registro; configurar SMTP para enviarlos de verdad.
# Tiempo real (Laravel Reverb en el contenedor sigma_reverb). Generar KEY/SECRET con: openssl rand -hex 16
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=sigma
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=sigma_reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ORIGENES=sigma.proyectoscampus.top

# Microservicio de analítica (contenedor sigma_analitica). Generar con: openssl rand -hex 32
ANALITICA_URL=http://sigma_analitica:8001
ANALITICA_CLAVE=

# Archivos (fotos, firmas, certificados, informes y planillas en PDF) en el Object Storage de SIGMA.
# Solo el bucket «sigma»; las llaves viven únicamente aquí (nunca en Git ni en variables VITE_*).
SIGMA_DISCO_ARCHIVOS=objetos
OBJECT_STORAGE_ENDPOINT=https://usc1.contabostorage.com
OBJECT_STORAGE_REGION=default
OBJECT_STORAGE_BUCKET=sigma
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PREFIX=produccion
OBJECT_STORAGE_USE_PATH_STYLE_ENDPOINT=true

# Operación: límite general de la API, aviso por disco libre y consulta de credenciales en «Roles y permisos»
# (en la instalación de un cliente real: SIGMA_MOSTRAR_CREDENCIALES=false).
SIGMA_LIMITE_API_POR_MINUTO=300
SIGMA_DISCO_MINIMO_LIBRE=10
SIGMA_MOSTRAR_CREDENCIALES=true

# SMS para recuperar la contraseña con el celular: log, twilio, n8n o simulado (ver README).
SIGMA_SMS=simulado
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_NUMERO=
# SIGMA_SMS_N8N_URL=

# Asistentes con IA en n8n (flujos «SIGMA» y «SIGMA Landing»). Mientras no haya API de DeepSeek: false.
ASISTENTE_N8N_ACTIVO=false
ASISTENTE_N8N_URL_PANEL=https://n8n.proyectoscampus.top/webhook/sigma-asistente-panel
ASISTENTE_N8N_URL_LANDING=https://n8n.proyectoscampus.top/webhook/sigma-asistente-landing
ASISTENTE_N8N_CLAVE=
# Tope diario de preguntas del asistente público a la IA (costo). Al pasarlo responde el motor local. 0 = sin tope.
ASISTENTE_LIMITE_DIARIO_PUBLICO=500

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@proyectoscampus.top"
MAIL_FROM_NAME="SIGMA"
